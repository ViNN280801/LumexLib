/**
 * @file LumexXml
 * @brief XML module: a DOM tree of nodes, attributes and text, loading and
 * saving with writers for files and streams, and XPath queries with variables.
 * @details Link <tt>%lumex::xml</tt> (shared library). Works from C++11; the
 * `std::string_view` overloads appear from C++17 as inline wrappers over the
 * exported functions. The umbrella includes the DOM classes, the writer
 * interface and its file and stream implementations, the parse result, the
 * XPath classes, the common types and constants, and `XmlCleaner` and
 * `XmlUtils`. Linking it also links <tt>%lumex::unicode</tt>, whose UTF
 * transcoders the parser and the buffer conversions use.
 *
 * The module is derived from pugixml (https://github.com/zeux/pugixml,
 * MIT, Copyright (c) 2006-2026 Arseny Kapoulkine); its notice is in
 * `THIRD-PARTY-NOTICES.md`, installed with the library.
 */
#ifndef LUMEX_XML_HPP
#define LUMEX_XML_HPP

// Core XML classes
#include "attribute/XmlAttribute.hpp"
#include "document/XmlDocument.hpp"
#include "node/XmlNode.hpp"
#include "text/XmlText.hpp"

// XML Writer interface and implementations
#include "writer/IXmlWriter.hpp"
#include "writer/XmlWriterFile.hpp"
#include "writer/XmlWriterStream.hpp"

// Parsing results
#include "text/XmlParseResult.hpp"

// XPath related classes
#include "xpath/exception/XPathException.hpp"
#include "xpath/node/XPathNode.hpp"
#include "xpath/node/XPathNodeSet.hpp"
#include "xpath/query/XPathQuery.hpp"
#include "xpath/variable/XPathVariable.hpp"
#include "xpath/variable/XPathVariableSet.hpp"

// Common types and constants
#include "constants/XmlConstants.hpp"
#include "types/XmlTypes.hpp"
#include "xpath/constants/XPathConstants.hpp"

// While not strictly necessary for every public function, these provide
// fundamental utilities that might be exposed or used by exported classes.
#include "utility/XmlCleaner.hpp"
#include "utility/XmlUtils.hpp"

#endif // !LUMEX_XML_HPP
