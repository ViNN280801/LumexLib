# 99-lumex-serial.rules
#
# udev rule template: access to Lumex devices without root.
#
# Devices with the USB vendor id 16e0 (the line matches ATTRS{idVendor}; a
# USB serial adapter with its own vendor and product id needs a line of its
# own, see README.md, "A different adapter") get the group rw access on their
# device nodes, MODE 0660 (group only, no access for others):
#   - ttyUSB* and ttyACM* (a USB serial adapter or a CDC device) belong to the
#     group "dialout";
#   - hidraw* (a HID device) belongs to the group "plugdev".
# The user must be a member of that group (see README.md), or the rule is
# changed to the group the user already has.
#
# Alternative without group membership: 70-lumex-uaccess.rules (the user of
# the active local session gets the access).
#
# Install (see README.md; the package carries the file in
# share/LumexLib/udev):
#          sudo cp 99-lumex-serial.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules
#          sudo udevadm trigger
# The device must be plugged in again if the trigger did not change its node.

# Serial nodes of a USB serial adapter (FTDI, CP210x, CH340 and similar).
SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", ATTRS{idVendor}=="16e0", MODE="0660", GROUP="dialout"

# Serial nodes of a CDC ACM device.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", ATTRS{idVendor}=="16e0", MODE="0660", GROUP="dialout"

# HID devices (/dev/hidrawN).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="16e0", MODE="0660", GROUP="plugdev"
