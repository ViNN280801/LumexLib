/**
 * @file LumexUtility
 * @brief Utility module, the foundation of the library: assertion, attribute,
 * keyword and constant macros, compiler, feature and OS checks, type traits,
 * stack text and core dumps, demangling, safe numeric comparison (with the
 * ordering classes of its three-way result), bit and byte order helpers, the
 * iterator range, the process id and a callback slot.
 * @details Link <tt>%lumex::utility</tt> (compiled library; it links
 * <tt>%lumex::math</tt>, <tt>%lumex::optional</tt> and <tt>%lumex::span</tt>).
 * Works from C++11. The umbrella also includes `bit/`, `cast/`, `mem/` and
 * `ranges/`. In them `count_leading_zeros`, `byte_swap`, `is_little_endian`,
 * `iterator_range` and `mem::as` (reads a value out of raw bytes; the result is
 * `std::optional` from C++17 and the optional of `lumex::optional` before it,
 * `mem::optional_t`) work from C++11; the rest needs C++20, and each header
 * checks its own features and declares nothing where the toolchain lacks them.
 */
#include "assert/LumexAssert.hpp"
#include "attr/LumexAttributes.hpp"
#include "callback/LumexCallbackSlot.hpp"
#include "compiler/LumexCheckCompiler.hpp"
#include "compiler/LumexCheckFeatures.hpp"
#include "debug/LumexDebug.hpp"
#include "demangle/LumexDemangle.hpp"
#include "dump/LumexCoreDumpGenerator.hpp"
#include "macros/LumexConstantMacros.hpp"
#include "macros/LumexKeywords.hpp"
#include "macros/LumexMacros.hpp"
#include "numeric/LumexOrdering.hpp"
#include "numeric/LumexSafeNumericComparator.hpp"
#include "os/LumexCheckOS.hpp"
#include "process/LumexProcess.hpp"
#include "traits/LumexTypeTraits.hpp"
#include "util/LumexUtilities.hpp"

#include "bit/LumexBit.hpp"
#include "cast/LumexCast.hpp"
#include "mem/LumexMemRead.hpp"
#include "ranges/LumexIteratorRange.hpp"
#include "ranges/LumexRanges.hpp"
