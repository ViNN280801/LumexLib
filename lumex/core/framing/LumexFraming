/**
 * @file LumexFraming
 * @brief Framing module: codecs that turn payloads into frames and a byte
 * stream back into frames, with no I/O and no threads.
 * @details Link <tt>%lumex::framing</tt> (compiled library: it holds the
 * error category; the codecs are header-only). Works from C++11. The contract
 * of every codec is in `codec/LumexFramingCodec.hpp`, the error codes in
 * `codec/LumexFramingErrc.hpp`. The codecs: `slip::slip_codec` (RFC 1055),
 * `cobs::cobs_codec`, `delimiter::delimiter_codec` (text lines),
 * `length::length_prefix_codec`, `header::header_codec<Check>` (binary
 * headers with a length field and a check value),
 * `modbus_rtu::modbus_rtu_codec`; `stage::pipeline<Outer, Stage...>` adds
 * transformations of the frame (prefix byte, ASCII hex, check value, word
 * reversal) to any of them.
 */
#include "codec/LumexFramingErrc.hpp"

#include "codec/LumexFramingCodec.hpp"

#include "cobs/LumexCobsCodec.hpp"
#include "delimiter/LumexDelimiterCodec.hpp"
#include "header/LumexHeaderCodec.hpp"
#include "length/LumexLengthPrefixCodec.hpp"
#include "modbus_rtu/LumexModbusRtuCodec.hpp"
#include "slip/LumexSlipCodec.hpp"
#include "stage/LumexFramingPipeline.hpp"
#include "stage/LumexFramingStages.hpp"
