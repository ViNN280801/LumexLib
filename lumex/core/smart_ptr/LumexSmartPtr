/**
 * @file LumexSmartPtr
 * @brief Smart pointer module: `shared_ptr`, `weak_ptr`,
 * `enable_shared_from_this`, `make_shared`, `allocate_shared`, the pointer
 * casts, `owner_less`, `bad_weak_ptr` and the explicit conversions to and
 * from `std::shared_ptr`, with the module's own control block.
 * @details Link <tt>%lumex::smart_ptr</tt> (header-only). Works from C++11.
 * The classes have the interface of the C++17 `std::shared_ptr` family
 * (arrays included; the array forms of `make_shared` of C++20 are not
 * provided; `unique ()` is not provided) but are never aliases of the
 * standard types: the control block packs the strong counter and a debt
 * ledger into one 64-bit atomic word and a weak ledger into another, which
 * the split-count engine of `core/atomic` needs. The names are in
 * `lumex::core::smart_ptr` and are not injected into the global namespace.
 * The umbrella includes `shared/LumexSharedPtr.hpp`,
 * `weak/LumexWeakPtr.hpp`, `shared/LumexEnableSharedFromThis.hpp`,
 * `make/LumexMakeShared.hpp`, `shared/LumexBadWeakPtr.hpp` and
 * `interop/LumexSmartPtrStd.hpp`; the control blocks and the counters are in
 * `ctl/` and the helpers (the `detail::access` friend, the traits, the
 * configuration macros) in `detail/`.
 * @see The `README.md` page next to this umbrella (part of the documentation).
 */
#include "interop/LumexSmartPtrStd.hpp"
#include "make/LumexMakeShared.hpp"
#include "shared/LumexBadWeakPtr.hpp"
#include "shared/LumexEnableSharedFromThis.hpp"
#include "shared/LumexSharedPtr.hpp"
#include "weak/LumexWeakPtr.hpp"
