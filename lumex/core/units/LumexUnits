/**
 * @file LumexUnits
 * @brief Units module: a header-only catalog of the units of measurement (the
 * SI, the units of GOST 8.417-2024, the CGS units and the standard atmosphere)
 * with their symbols in two scripts, the 24 SI prefixes, exact conversion
 * factors, a lookup of a symbol and the conversion of a value.
 * @details Link <tt>%lumex::units</tt> (header-only). Works from C++11. The
 * umbrella includes `data/LumexUnitsData.hpp` (the enumerations, the
 * aggregates and the catalog as X-macros; it uses nothing but `<cstddef>` and
 * `<cstdint>`) and `api/LumexUnitsApi.hpp` (the lookup, the formatting of a
 * symbol, the exact `ratio` and the conversions `convert`, `convert_point`
 * and `convert_difference`). The names are in `lumex::core::units` and are
 * not injected into the global namespace; the helpers of the API are in
 * `lumex::core::units::detail`.
 *
 * The international symbols follow the SI Brochure, 9th edition, version 4.01,
 * the Russian ones GOST 8.417-2024; the measured values (the dalton) are those
 * of CODATA 2022. The rows that the two amendments of 2025 to the GOST may
 * touch were not checked against them.
 */
#include "api/LumexUnitsApi.hpp"
#include "data/LumexUnitsData.hpp"
