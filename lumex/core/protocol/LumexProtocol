/**
 * @file LumexProtocol
 * @brief Protocol module: an exchange protocol described once as a table,
 * from which the library generates typed command types, names, run-time
 * entries and the client mixin.
 * @details Link <tt>%lumex::protocol</tt> (compiled library: it holds the
 * error category; the DSL is header-only). Works from C++11. The table
 * macros are in `dsl/LumexProtocolDefine.hpp` (`LUMEX_PROTOCOL_DEFINE`,
 * `LUMEX_PROTOCOL_EXTEND`, `LUMEX_PROTOCOL_EXTEND_FRAMED`,
 * `LUMEX_PROTOCOL_LAYOUT`), the names a table uses in
 * `dsl/LumexProtocolVocabulary.hpp`, the options in
 * `dsl/LumexProtocolOptions.hpp`, the run-time entries in
 * `dsl/LumexProtocolEntry.hpp`, the collision guard in
 * `dsl/LumexProtocolPlatformMacros.hpp`, the error codes in
 * `error/LumexProtocolErrc.hpp`, the field types in `field/` (integers,
 * floating, text, bits, enumerations, arrays, tails, unions, nested
 * messages) and the three layouts with their encoders and decoders in
 * `layout/` (`binary_layout`, `fixed_width_text_layout`,
 * `tokenized_text_layout`; `layout::encode_request`, `decode_reply`, ...),
 * the parameter and register tables in `registry/` (`LUMEX_PROTOCOL_REGISTRY`,
 * `registry_key_`, `registry_value_`, `verify_registry`), the run-time index
 * with `describe` and the session context in `index/` (`build_index`,
 * `protocol_index`, `session_context_t`) and the Markdown export in
 * `export/`. `export/LumexProtocolExportJson.hpp` (`export_json`) is
 * included on its own: it needs `LUMEX_PROTOCOL_WITH_JSON` and the
 * consumer's nlohmann/json.
 */
#include "error/LumexProtocolErrc.hpp"

#include "dsl/LumexProtocolDefine.hpp"
