/**
 * @file LumexSettings
 * @brief Settings module: section, key and value configuration files in INI,
 * JSON or XML behind one interface, plus a guard that restores default keys,
 * backs up a corrupted file and validates values.
 * @details Link <tt>%lumex::settings</tt> (compiled library). Works from C++11.
 * INI is always available; XML when <tt>%lumex::xml</tt> is part of the build
 * (`LUMEX_SETTINGS_WITH_XML`), JSON when the vendored nlohmann/json header is
 * present (`LUMEX_SETTINGS_WITH_JSON`). The umbrella includes the interface
 * (`interface/ILumexSettings.hpp`), the factory, the guard, the INI, JSON
 * and XML implementations, and `storage::replace_file_content`, the write
 * through a temporary file that their `save` uses.
 */
#include "interface/ILumexSettings.hpp"

#include "factory/LumexSettingsFactory.hpp"

#include "guard/LumexSettingsGuard.hpp"

#include "ini/LumexSettingsINI.hpp"
#include "ini/SupportedConfigExtensions.hpp"

#include "json/LumexSettingsJSON.hpp"

#include "storage/LumexSettingsStorage.hpp"

#include "xml/LumexSettingsXML.hpp"
