/**
 * @file LumexTransport
 * @brief Transport module: byte streams and message transports over Asio
 * (serial, TCP, UDP, USB HID), synchronous with deadlines and asynchronous
 * with any completion token.
 * @details Link <tt>%lumex::transport</tt> (always a static library; it links
 * <tt>%lumex::serial</tt> and the vendored Asio, and Boost.Context with
 * `LUMEX_TRANSPORT_WITH_SPAWN`). Works from C++11. The error codes are in
 * `error/LumexTransportErrc.hpp`, the log in `log/LumexTransportLog.hpp`, the
 * counters (`byte_stream::statistics ()`) in
 * `statistics/LumexTransportStatistics.hpp`, the sessions that reconnect
 * (`stream_session`, `message_session`), the selectors and the
 * `device_watcher` in `session/`, the timer seam they wait on in `time/`.
 * Behind their options the umbrella also includes the adapter to the logger
 * (`LUMEX_BUILD_LOGGER`, `log/adapter/`) and the mocks and the virtual clock
 * of `testing/` (`LUMEX_TRANSPORT_WITH_TESTING`).
 */
#include "datagram/LumexMessageTransport.hpp"

#include "error/LumexTransportErrc.hpp"

// The framed adapters need the framing module (LUMEX_BUILD_FRAMING): the
// transport library defines this macro for itself and its consumers then.
#if defined(LUMEX_TRANSPORT_WITH_FRAMING)
#include "framed/LumexFramedDatagram.hpp"
#include "framed/LumexFramedStatistics.hpp"
#include "framed/LumexFramedStream.hpp"
#include "framed/LumexFramedTypes.hpp"
#endif

// The HID transport needs hidapi (LUMEX_TRANSPORT_WITH_HID): the transport
// library defines this macro for itself and its consumers then.
#if defined(LUMEX_TRANSPORT_WITH_HID)
#include "hid/LumexHidDevice.hpp"
#include "hid/LumexHidReportDescriptor.hpp"
#include "hid/LumexHidSelectors.hpp"
#endif

#include "log/LumexTransportLog.hpp"

// The adapter to the logger module (LUMEX_BUILD_LOGGER): the transport library
// defines this macro for itself and its consumers then.
#if defined(LUMEX_TRANSPORT_WITH_LOGGER)
#include "log/adapter/LumexTransportLoggerAdapter.hpp"
#endif

#include "net/LumexNetTransports.hpp"

#include "serial/LumexSerialStream.hpp"

#include "session/LumexBasicSession.hpp"
#include "session/LumexDeviceWatcher.hpp"
#include "session/LumexMessageSession.hpp"
#include "session/LumexSessionSelectors.hpp"
#include "session/LumexSessionTypes.hpp"
#include "session/LumexStreamSession.hpp"

#include "statistics/LumexTransportStatistics.hpp"

#include "stream/LumexByteStream.hpp"
#include "stream/LumexIoRunner.hpp"
#include "stream/LumexStreamTypes.hpp"

#include "timing/LumexTimerSource.hpp"

// The mocks for tests of code built on the transport
// (LUMEX_TRANSPORT_WITH_TESTING, off by default): the transport library
// defines this macro for itself and its consumers then.
#if defined(LUMEX_TRANSPORT_WITH_TESTING)
#include "testing/LumexMockDatagram.hpp"
#include "testing/LumexMockStream.hpp"
#include "testing/LumexVirtualClock.hpp"
#endif
