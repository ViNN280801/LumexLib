# LumexLib clangd config.
# compile_commands.json at this directory is the only compilation database.
# Do not use Ancestors: the parent PeakExpertWeb tree has its own
# compile_commands.json (MSVC cl.exe, zero LumexLib entries) and an
# identical .clangd that would merge -x c++ / UNIT_TEST / FMT_CONSTEVAL
# and UnusedIncludes: Strict on top of clang-cl commands.

CompileFlags:
  CompilationDatabase: .

  Remove:
    - "/external:I.*"
    - "/MP"
    - "/GL"
    - "/Zc:throwingNew"
    - "-flto=thin"
    - "-DFMT_CONSTEVAL="
    - "-DUNIT_TEST"
    - "-DTEST_BUILD"

Index:
  Background: Build
  StandardLibrary: true

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - unused-includes
    - llvmlibc-callee-namespace
    - llvmlibc-inline-function-decl
    - llvmlibc-restrict-system-libc-headers
    - llvmlibc-implementation-in-namespace
  ClangTidy:
    Remove: ["*"]

---
If:
  PathMatch: .*/3rdparty/.*
Diagnostics:
  Suppress: ["*"]
Index:
  Background: Skip

---
If:
  PathMatch: .*/tests/.*
Diagnostics:
  Suppress:
    - unused-function
    - unused-variable
    - unused-includes
    - cert-err58-cpp
    - cppcoreguidelines-avoid-non-const-global-variables
  ClangTidy:
    Remove: ["*"]

---
Completion:
  AllScopes: Yes
  ArgumentLists: FullPlaceholders

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
  BlockEnd: false
  DefaultArguments: false
  TypeNameLimit: 24

Hover:
  ShowAKA: true
