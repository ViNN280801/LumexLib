# Universal clangd Configuration for Team Development
# This configuration works on any OS, any location, and for any developer
# It uses compile_commands.json as the primary source of truth
# All paths are relative to the project root

# ============================================================================
# COMPILATION DATABASE CONFIGURATION
# ============================================================================
# Primary: Use compile_commands.json (generated by CMake/Bazel/etc.)
# clangd will automatically search parent directories for compile_commands.json
# This makes the config work regardless of project location
CompileFlags:
  # Automatically search for compile_commands.json in parent directories
  # This is the default behavior, but we make it explicit
  CompilationDatabase: Ancestors

  # Fallback flags (used only if compile_commands.json is not found)
  # These are minimal flags that work across platforms
  Add:
    # C++ Standard (adjust based on your project needs)
    - -std=c++20

    # Common warning flags (cross-platform)
    - -Wall
    - -Wextra
    - -Wpedantic

    # Error limit (prevent clangd from stopping on too many errors)
    - -ferror-limit=0

    # Relative include paths (adjust based on your project structure)
    # These paths are relative to the .clangd file location
    - -Isrc
    - -Iinclude
    - -I.
  # Platform-specific flags (using conditional compilation)
  # These will be applied based on the compiler detected by clangd

  # ============================================================================
  # PLATFORM-SPECIFIC CONFIGURATION
  # ============================================================================
  # Different configurations for different platforms
  # clangd automatically detects the platform from compile_commands.json

---
# Windows-specific configuration (MSVC/clang-cl)
If:
  PathMatch: .*\.(cpp|hpp|cc|cxx|h|hxx)$
CompileFlags:
  Compiler: clang-cl
  Add:
    # MSVC-compatible flags
    - /std:c++20
    - /W4
    - /permissive-
    - /Zc:__cplusplus
    - /EHsc
    # Windows-specific defines (only if compile_commands.json doesn't provide them)
    - -D_WIN32_WINNT=0x0A00
    - -DWINVER=0x0A00
    - -DWIN32_LEAN_AND_MEAN
    - -DNOMINMAX
    - -DUNICODE
    - -D_UNICODE
---
# Linux/macOS-specific configuration (GCC/Clang)
If:
  PathMatch: .*\.(cpp|hpp|cc|cxx|h|hxx)$
CompileFlags:
  Compiler: clang++
  Add:
    # GCC/Clang flags
    - -std=c++20
    - -Wall
    - -Wextra
    - -Wpedantic
    - -ferror-limit=0

# ============================================================================
# FILE TYPE-SPECIFIC CONFIGURATION
# ============================================================================
---
# C++ source files
If:
  PathMatch: .*\.(cpp|cc|cxx|ixx|cppm)$
CompileFlags:
  Add:
    - -x
    - c++
---
# C++ header files
If:
  PathMatch: .*\.(hpp|hxx|h|ipp|inl)$
CompileFlags:
  Add:
    - -x
    - c++-header
---
# C source files
If:
  PathMatch: .*\.c$
CompileFlags:
  Add:
    - -x
    - c
    - -std=c11
---
# C header files
If:
  PathMatch: .*\.h$
  PathExclude: .*\.(hpp|hxx)$
CompileFlags:
  Add:
    - -x
    - c-header
    - -std=c11
---
# Test files (often have different requirements)
If:
  PathMatch: .*test.*\.(cpp|hpp)$
CompileFlags:
  Add:
    - -DUNIT_TEST
    - -DTEST_BUILD
Diagnostics:
  Suppress:
    - unused-function
    - unused-variable
---
# Third-party code (exclude from strict diagnostics)
If:
  PathMatch: .*/(3rdparty|third_party|external|vendor)/.*
Diagnostics:
  Suppress: ["*"]
Index:
  Background: Skip

# ============================================================================
# INDEXING CONFIGURATION
# ============================================================================
---
Index:
  # Build index in background using compile_commands.json
  # This provides fast code navigation and completion
  Background: Build

  # Index standard library for better completion
  StandardLibrary: true

# ============================================================================
# DIAGNOSTICS CONFIGURATION
# ============================================================================
---
Diagnostics:
  # Include Cleaner: detect unused includes
  UnusedIncludes: Strict

  # Include Cleaner: detect missing includes (can be noisy, enable if needed)
  # MissingIncludes: None

  # Suppress specific diagnostics that are too noisy or project-specific
  Suppress:
    # Modernize checks that might be too aggressive
    - modernize-use-trailing-return-type
    - readability-braces-around-statements
    # Disable LLVM libc specific checks (not part of -llvm-*) (not applicable for any project)
    - llvmlibc-implementation-in-namespace
    - llvmlibc-inline-function-decl
    - llvmlibc-restrict-system-libc-headers
    - llvmlibc-callee-namespace
  # Project-specific suppressions (add as needed)
  # - cppcoreguidelines-pro-type-reinterpret-cast
  # - readability-function-cognitive-complexity

  # clang-tidy configuration
  # NOTE: Detailed clang-tidy configuration is in .clang-tidy file
  # clangd automatically uses .clang-tidy if present in the project root
  # This section only contains clangd-specific settings (FastCheckFilter)
  ClangTidy:
    # Fast check filter: only run fast checks to avoid slowing down clangd
    # Full clang-tidy configuration (checks, options, warnings as errors)
    # is defined in .clang-tidy file
    FastCheckFilter: Strict

  # Include Cleaner configuration
  Includes:
    # Ignore headers that are commonly included but not directly used
    IgnoreHeader:
      - <windows\.h>
      - <stdio\.h>
      - <stdlib\.h>
      - <string\.h>
      - <memory>
      - <vector>
      - <string>
      - <iostream>
    # Analyze angled includes (can produce false positives)
    AnalyzeAngledIncludes: false

# ============================================================================
# COMPLETION CONFIGURATION
# ============================================================================
Completion:
  # Include suggestions from all scopes (even if not visible)
  # The required scope prefix will be inserted automatically
  AllScopes: Yes

  # Argument list completion style
  # FullPlaceholders: shows full parameter names (e.g., foo(int arg))
  ArgumentLists: FullPlaceholders

  # Automatically insert #include when completing symbols
  # IWYU: Include What You Use - inserts owning header
  HeaderInsertion: IWYU

  # Enable code patterns and snippets
  CodePatterns: All

# ============================================================================
# INLAY HINTS CONFIGURATION
# ============================================================================
InlayHints:
  # Enable inlay hints feature
  Enabled: Yes

  # Show parameter names in function calls
  ParameterNames: Yes

  # Show deduced types (auto, template types)
  DeducedTypes: Yes

  # Show designators in aggregate initialization
  Designators: Yes

  # Show block end comments (e.g., // foo for closing brace)
  BlockEnd: false

  # Show default arguments
  DefaultArguments: false

  # Limit type name length in hints (0 = no limit)
  TypeNameLimit: 24

# ============================================================================
# HOVER CONFIGURATION
# ============================================================================
Hover:
  # Show "aka" (also known as) for desugared types
  # e.g., vector<int>::value_type (aka int)
  ShowAKA: false

  # Limit macro expansion length in hover (0 = no limit)
  MacroContentsLimit: 2048

# ============================================================================
# SEMANTIC TOKENS CONFIGURATION
# ============================================================================
SemanticTokens:
  # Disable specific semantic token kinds if needed
  DisabledKinds: []

  # Disable specific semantic token modifiers if needed
  DisabledModifiers: []

# ============================================================================
# DOCUMENTATION CONFIGURATION
# ============================================================================
Documentation:
  # Comment format interpretation
  # Options: Plaintext, Markdown, Doxygen
  # Doxygen: parses Doxygen comments and converts to markdown
  CommentFormat: Doxygen

# ============================================================================
# STYLE CONFIGURATION
# ============================================================================
Style:
  # Namespaces that should always be fully qualified
  # (no "using" declarations, always spell out full name)
  FullyQualifiedNamespaces: []

  # Headers that should use quoted includes ("")
  QuotedHeaders:
    - "src/.*"
    - "include/.*"
    - ".*/.*\\.hpp"
    - ".*/.*\\.h"
  # Headers that should use angled includes (<>)
  AngledHeaders:
    - ".*/3rdparty/.*"
    - ".*/third_party/.*"
    - ".*/external/.*"
    - ".*/vendor/.*"
    - "<.*>"
# ============================================================================
# NOTES FOR DEVELOPERS
# ============================================================================
#
# 1. PRIMARY SOURCE: compile_commands.json
#    - This config relies on compile_commands.json as the primary source
#    - Generate it using: cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
#    - Or use Bear/compiledb for other build systems
#
# 2. RELATIVE PATHS: All include paths in this config are relative
#    - They work regardless of where the project is located
#    - Adjust the -I paths in CompileFlags.Add based on your project structure
#
# 3. PLATFORM DETECTION: clangd automatically detects platform from compile_commands.json
#    - The If blocks above are fallbacks if compile_commands.json is missing
#    - In practice, compile_commands.json should provide all platform-specific flags
#
# 4. CUSTOMIZATION: For project-specific settings
#    - Add custom include paths in CompileFlags.Add (use relative paths)
#    - Add project-specific defines in CompileFlags.Add
#    - Adjust Diagnostics.Suppress for project-specific needs
#    - Modify ClangTidy.Add/Remove based on your coding standards
#
# 5. USER CONFIG: For personal preferences
#    - Create ~/.config/clangd/config.yaml (Linux)
#    - Create ~/Library/Preferences/clangd/config.yaml (macOS)
#    - Create %LocalAppData%\clangd\config.yaml (Windows)
#    - User config overrides project config
#
# 6. TROUBLESHOOTING:
#    - If clangd can't find includes: check compile_commands.json exists
#    - If diagnostics are wrong: verify compile_commands.json is up to date
#    - If completion is slow: check Index.Background is set to Build
#    - Run: clangd --check=file.cpp to test configuration
#
# ============================================================================
