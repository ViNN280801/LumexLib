# Auto-detect text files and convert to LF at commit
* text=auto

# Explicitly specify text files (C/C++, Python, Bash, etc.)
*.c text
*.h text
*.cpp text
*.hpp text
*.py text
*.sh text
*.md text
*.txt text
*.yml text
*.yaml text
*.json text
*.cmake text
*.in text
*.csv text
# SVG is XML text: LF line endings, readable diffs
*.svg text

# Exceptions: files that MUST use CRLF (e.g., .bat)
*.bat text eol=crlf

# Binary files (so Git doesn't touch them)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pdf binary
*.exe

# Generated benchmark results: collapsed in the GitHub / GitLab diff views
benchmarks/**/results/** linguist-generated=true gitlab-generated=true
